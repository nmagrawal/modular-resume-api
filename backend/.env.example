# Copy to .env and fill in. Never commit the real .env.

# Which modular resume bank to read (defaults to the repo's own file if unset).
# RESUME_BANK_PATH=/path/to/your-resume-bank.md

# Header contact line — not resume-bank content, so it lives here instead.
# Any field left unset renders as a visible [[PLACEHOLDER]] rather than a guess.
RESUME_CONTACT_NAME=
RESUME_CONTACT_LOCATION=
RESUME_CONTACT_EMAIL=
RESUME_CONTACT_PHONE=
RESUME_CONTACT_LINKEDIN=
RESUME_CONTACT_GITHUB=
RESUME_CONTACT_SITE=

# Activates POST /generate-resume/ai (CrewAI summary-writing layer).
# Setting just an API key auto-detects LLM_PROVIDER — or set both explicitly
# (any LiteLLM-supported provider, including a local Ollama model):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=
# LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Enables semantic search for bullet/project relevance (see README's
# "Provider setup"). Unset = keyword-overlap scoring (the default).
# EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL=
# EMBEDDINGS_BASE_URL=

# When a role preset offers more candidate bullets than it uses (a plain 4-
# item primary list, or a documented "+X as a fourth" bonus), use the
# LLM_PROVIDER chat model above to pick instead of relevance scoring.
# /generate-resume stays fully offline unless this is explicitly true.
# LLM_BULLET_SELECTION=true
